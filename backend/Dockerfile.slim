# Agent Hub fork: slim backend image for small hosts (NAS, 8 GB RAM).
# Same app as backend/Dockerfile, but only the agents the hub uses: Claude Code,
# Codex and OpenCode (for API-key gateways). No Playwright/Chromium, Cursor, Grok,
# Antigravity, Copilot or Tailscale. Run it unprivileged (host sandbox mode,
# no docker.sock); see the hub repo's docker-compose.yml.
FROM python:3.12-slim

ARG CLAUDE_CODE_VERSION=2.1.325
ARG CLAUDE_AGENT_ACP_VERSION=0.107.0
ARG CODEX_VERSION=0.169.0
ARG CODEX_ACP_VERSION=2.6.0
ARG OPENCODE_VERSION=2.3.0

RUN groupadd -g 999 appuser && useradd -u 999 -g 999 -m -d /home/appuser appuser

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates gnupg && \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends gcc git gosu openssh-client gh ripgrep fd-find \
      jq less tree unzip tmux file procps psmisc lsof rsync patch && \
    ln -s "$(command -v fdfind)" /usr/local/bin/fd && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
      @agentclientprotocol/claude-agent-acp@${CLAUDE_AGENT_ACP_VERSION} \
      @agentclientprotocol/codex-acp@${CODEX_ACP_VERSION} @openai/codex@${CODEX_VERSION} && \
    npm cache clean --force && \
    apt-get purge -y gnupg && apt-get autoremove -y && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://opencode.ai/v2/install | bash -s -- --version ${OPENCODE_VERSION} && \
    cp /root/.opencode/bin/opencode /usr/local/bin/opencode && \
    chmod +x /usr/local/bin/opencode && rm -rf /root/.opencode

COPY --from=ghcr.io/astral-sh/uv:0.13.9 /uv /usr/local/bin/uv
COPY backend/requirements.lock .
RUN uv pip install --system --no-cache -r requirements.lock

COPY backend/ /app/
COPY mcp-server/ /app/mcp-server/

RUN chown -R appuser:appuser /app && chmod -R 755 /app && chmod +x /app/entrypoint.sh && \
    mkdir -p /data/agentrove/storage/images /data/agentrove/storage/pdfs /data/agentrove/storage/xlsx && \
    chown -R appuser:appuser /data/agentrove/storage

ENV HOME=/home/appuser \
    PYTHONUNBUFFERED=1 \
    TERM=xterm-256color \
    DISABLE_AUTOUPDATER=1

EXPOSE 8080
ENTRYPOINT ["/app/entrypoint.sh"]
CMD []
